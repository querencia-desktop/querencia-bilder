[Desktop Entry]
# Querencia Bilder. Desktop-ID = GApplication-ID org.querencia.Bilder, damit
# labwc und die Fensterliste das Fenster dieser Datei zuordnen.
# Vorlage: Name, GenericName, Comment und Keywords sind englisch; die
# Übersetzungen (Name[de]= …) setzt `werkzeug/i18n.py desktop` aus po/*.po
# ein (entspricht msgfmt --desktop). Erzeugt: org.querencia.Bilder.desktop.
# Menüname „Image Viewer“/„Bildbetrachter“ unter Grafik (Graphics ab 0.2.2,
# Pflichtprobe B3; bis 0.2.1 Utility) und MimeType wie bisher; der
# Fenstertitel bleibt „Querencia Bilder“. Querencia Bilder schreibt nie in
# Bilddateien. Symbole ohne 48x48 (GTK-4.22-Symbolregel).
Type=Application
Version=1.5
Name[de]=Bildbetrachter
Name[es]=Visor de imágenes
Name[fr]=Visionneur d’images
Name[it]=Visualizzatore immagini
Name=Image Viewer
GenericName[de]=Bildbetrachter
GenericName[es]=Visor de imágenes
GenericName[fr]=Visionneur d’images
GenericName[it]=Visualizzatore immagini
GenericName=Image Viewer
Comment[de]=Bilder ansehen
Comment[es]=Ver imágenes
Comment[fr]=Voir des images
Comment[it]=Visualizza le immagini
Comment=View images
Exec=querencia-bilder %U
TryExec=querencia-bilder
Icon=org.querencia.Bilder
Terminal=false
Categories=GTK;Graphics;Viewer;
MimeType=image/png;image/jpeg;image/gif;image/webp;image/bmp;image/svg+xml;
Keywords[de]=Bild;Foto;Betrachter;Bildbetrachter;
Keywords[es]=Imagen;Foto;Fotografía;Visor;
Keywords[fr]=Image;Photo;Visionneur;Visionneuse;
Keywords[it]=Immagine;Foto;Fotografia;Visualizzatore;
Keywords=Image;Picture;Photo;Viewer;
StartupNotify=true
StartupWMClass=org.querencia.Bilder
